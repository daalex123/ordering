# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Public site URL used in customer SMS order links (no trailing slash)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Optional: used only for local scripts / admin bootstrap (never expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Server-only OTP / SMS (never expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# TEXTBEE_DEVICE_ID=your_device_id
# TEXTBEE_API_KEY=your_api_key
# OTP_PEPPER=random-long-secret
# Optional extra admin mobiles for new-order SMS (comma-separated)
# ADMIN_SMS_PHONES=07XXXXXXXX,07YYYYYYYY
