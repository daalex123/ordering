# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Public site URL used in customer SMS order links (no trailing slash)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Optional: used only for local scripts / admin bootstrap (never expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Server-only OTP / SMS (never expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# TEXTBEE_DEVICE_ID=your_device_id
# TEXTBEE_API_KEY=your_api_key
# OTP_PEPPER=random-long-secret
# Optional extra admin mobiles for new-order SMS (comma-separated)
# ADMIN_SMS_PHONES=07XXXXXXXX,07YYYYYYYY

# Telegram platform bot for admin order alerts (server-only; never NEXT_PUBLIC_)
# Create once via @BotFather, then connect the channel from Admin → Settings
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_BOT_USERNAME=YourOrdersBot
# TELEGRAM_WEBHOOK_SECRET=random-long-secret
# After deploy, register webhook (include allowed_updates):
# curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#   -d "url=https://YOUR_DOMAIN/api/telegram/webhook" \
#   -d "secret_token=$TELEGRAM_WEBHOOK_SECRET" \
#   -d 'allowed_updates=["message","my_chat_member","channel_post"]'
